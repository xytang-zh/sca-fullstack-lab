<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.xytang</groupId>
    <artifactId>spring-cloud-alibaba</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>spring-cloud-alibaba</name>
    <description>SCA 一体化平台后端聚合工程</description>

    <modules>
        <module>spring-cloud-auth</module>
        <module>spring-cloud-common</module>
        <module>spring-cloud-gateway</module>
        <module>spring-cloud-services</module>
    </modules>

    <properties>
        <!-- JDK 与编码 -->
        <java.version>21</java.version>                       <!-- 语言版本：JDK 21 -->
        <maven.compiler.source>21</maven.compiler.source>    <!-- 编译兼容源版本 -->
        <maven.compiler.target>21</maven.compiler.target>    <!-- 编译兼容目标版本 -->
        <maven.compiler.release>21</maven.compiler.release>  <!-- release 编译开关（Aligning javac 与 runtime） -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>          <!-- 源码编码 -->
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding> <!-- 报告编码 -->

        <!-- ===== 基座与微服务 ===== -->
        <spring-boot.version>3.5.0</spring-boot.version>               <!-- Spring Boot 基座 -->
        <spring-cloud.version>2025.0.0</spring-cloud.version>          <!-- Spring Cloud 微服务规范 -->
        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version> <!-- SCA：Nacos/Sentinel/Seata -->
        <dubbo.version>3.3.6</dubbo.version>                       <!-- Apache Dubbo RPC（SCA BOM 不管理，需自引） -->

        <!-- ===== 认证与权限 ===== -->
        <sa-token.version>1.44.0</sa-token.version>                <!-- Sa-Token：登录/权限/SSO/OAuth2 -->

        <!-- ===== ORM / 数据 ===== -->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>                 <!-- MyBatis-Plus ORM 增强 -->
        <dynamic-datasource.version>4.3.1</dynamic-datasource.version>     <!-- 多数据源切换 -->
        <shardingsphere.version>5.5.2</shardingsphere.version>             <!-- 分库分表 -->

        <!-- ===== 缓存与锁 ===== -->
        <redisson.version>4.0.0</redisson.version>      <!-- Redisson 分布式锁/限流 -->
        <caffeine.version>3.2.0</caffeine.version>      <!-- Caffeine 本地缓存（L1） -->

        <!-- ===== 消息队列 ===== -->
        <!-- rabbitmq 由 spring-boot-dependencies 管理 -->

        <!-- ===== 工具集 ===== -->
        <hutool.version>5.8.27</hutool.version>                 <!-- Hutool 通用工具 -->
        <jsoup.version>1.17.2</jsoup.version>                   <!-- Jsoup HTML 解析（XSS 过滤） -->
        <bouncycastle.version>1.78.1</bouncycastle.version>     <!-- Bouncy Castle：Argon2id 密码哈希 -->

        <!-- ===== API 文档 ===== -->
        <springdoc.version>2.6.0</springdoc.version>   <!-- springdoc-openapi：OpenAPI 3 -->
        <knife4j.version>4.5.0</knife4j.version>       <!-- Knife4j：增强文档 UI -->

        <!-- ===== 测试 ===== -->
        <testcontainers.version>1.20.0</testcontainers.version>              <!-- 测试容器 -->
        <testcontainers-redis.version>2.2.4</testcontainers-redis.version>   <!-- Redis 社区版测试容器 -->
        <archunit.version>1.3.0</archunit.version>                           <!-- 架构守护测试 -->
        <wiremock.version>3.9.1</wiremock.version>                           <!-- HTTP Mock -->

        <!-- ===== Maven 插件 ===== -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>      <!-- 编译插件 -->
        <maven-checkstyle-plugin.version>3.5.0</maven-checkstyle-plugin.version>  <!-- 阿里规范 checkstyle -->
        <versions-maven-plugin.version>2.17.1</versions-maven-plugin.version>     <!-- 依赖版本检查 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM：统一管理 Boot 自身依赖版本 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba BOM：Nacos / Sentinel / Seata / Dubbo -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Apache Dubbo BOM：SCA BOM 不管理 Dubbo 版本，需自行导入 -->
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-bom</artifactId>
                <version>${dubbo.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Sa-Token 全家桶 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-bom</artifactId>
                <version>${sa-token.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MyBatis-Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- dynamic-datasource -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
                <version>${dynamic-datasource.version}</version>
            </dependency>

            <!-- Redisson -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- ShardingSphere -->
            <dependency>
                <groupId>org.apache.shardingsphere</groupId>
                <artifactId>shardingsphere-jdbc</artifactId>
                <version>${shardingsphere.version}</version>
            </dependency>

            <!-- Caffeine -->
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>

            <!-- Hutool -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-bom</artifactId>
                <version>${hutool.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- Jsoup（HTML 解析，不在任何 BOM 中） -->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>

            <!-- Bouncy Castle（Argon2id 密码哈希依赖） -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

            <!-- ArchUnit（架构守护，不在任何 BOM 中） -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <!-- WireMock（HTTP Mock，不在任何 BOM 中） -->
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>

            <!-- Testcontainers-Redis（社区版，Testcontainers BOM 不管理 redis） -->
            <dependency>
                <groupId>com.redis</groupId>
                <artifactId>testcontainers-redis</artifactId>
                <version>${testcontainers-redis.version}</version>
            </dependency>

            <!-- API 文档 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- Testcontainers -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ===== 项目内部模块：版本统一为 ${project.version} ===== -->
            <dependency>
                <groupId>com.xytang</groupId>
                <artifactId>spring-cloud-common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xytang</groupId>
                <artifactId>spring-cloud-common-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xytang</groupId>
                <artifactId>spring-cloud-common-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xytang</groupId>
                <artifactId>spring-cloud-common-mybatis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xytang</groupId>
                <artifactId>spring-cloud-common-satoken</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xytang</groupId>
                <artifactId>spring-cloud-common-dubbo</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 编译插件：release 对齐 JDK、保留方法参数名（@RequiredArgsConstructor 构造器注入依赖） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <!-- Spring Boot 打包：生成可执行 JAR / 启动 spring-boot:run -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <!-- Checkstyle：绑定 validate 阶段执行阿里规范，违规即 build 失败 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <configuration>
                        <configLocation>${maven.multiModuleProjectDirectory}/src/checkstyle.xml</configLocation>
                        <suppressionsLocation>${maven.multiModuleProjectDirectory}/src/checkstyle-suppressions.xml</suppressionsLocation>
                        <suppressionsFileExpression>checkstyle.suppressions.file</suppressionsFileExpression>
                        <consoleOutput>true</consoleOutput>
                        <failOnViolation>true</failOnViolation>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    </configuration>
                    <executions>
                        <execution>
                            <id>checkstyle-validate</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>

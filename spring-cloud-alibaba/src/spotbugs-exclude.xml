<?xml version="1.0" encoding="UTF-8"?>
<!--
    SCA 一体化平台后端 SpotBugs 排除规则
    排除框架生成的代码、Lombok 注解类、特定 Java 21 模式误报。
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/4.8.6/spotbugs/etc/findbugsfilter.xsd">

    <!-- 排除测试代码的部分误报 -->
    <Match>
        <Class name="~.*Test"/>
        <Bug pattern="NP_NULL_ON_SOME_PATH,UR_UNINITIALIZED_READ,SIC_INNER_SHOULD_BE_STATIC_ANON"/>
    </Match>

    <!-- 排除 Lombok 生成代码 -->
    <Match>
        <Class name="~.*\$\$.*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP"/>
    </Match>

    <!-- 排除 Spring Boot 启动类 -->
    <Match>
        <Class name="~.*Application"/>
        <Bug pattern="UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD,SS_SHOULD_BE_STATIC"/>
    </Match>

    <!-- 排除 MyBatis-Plus 实体类（使用 @Data + @TableName） -->
    <Match>
        <Class annotations="com.baomidou.mybatisplus.annotation.TableName"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,UWF_UNWRITTEN_FIELD,NP_NONNULL_FIELD_VIOLATION"/>
    </Match>

    <!-- 排除 DTO/VO/Query 类（纯 POJO） -->
    <Match>
        <Class name="~.*\.(dto|vo|query|entity)\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,UWF_UNWRITTEN_FIELD"/>
    </Match>

    <!-- 允许在 Configuration 类中注入 @Bean -->
    <Match>
        <Class annotations="org.springframework.context.annotation.Configuration"/>
        <Bug pattern="SIC_INNER_SHOULD_BE_STATIC"/>
    </Match>
</FindBugsFilter>
